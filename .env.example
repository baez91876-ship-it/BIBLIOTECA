# Copia este archivo a .env y genera una clave JWT aleatoria de al menos 32 caracteres.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000
DATABASE_URL=postgresql://biblioteca:change_this_password@localhost:5432/libreria
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
APP_ENV=development
