# Cambia las credenciales y genera una clave JWT aleatoria antes de publicar.
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql://biblioteca:change_this_local_password@db:5432/libreria
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
